// This tells Prisma to generate the TypeScript client
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// This tells Prisma where your database is
datasource db {
  provider = "postgresql"
}

// --- OUR DATA MODELS ---

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  links     Link[]
}

model Link {
  id             String   @id @default(uuid())
  shortCode      String   @unique
  originalUrl    String
  clickCount     Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // NEW: Relation to click events
  clickEvents    ClickEvent[]
}

// NEW: Detailed click analytics
model ClickEvent {
  id          String   @id @default(uuid())
  clickedAt   DateTime @default(now())
  
  // Device & Browser Info
  deviceType  String?  // "mobile", "desktop", "tablet", "unknown"
  browser     String?  // "Chrome", "Safari", "Firefox", "Edge", "unknown"
  os          String?  // "Windows", "macOS", "iOS", "Android", "Linux", "unknown"
  
  // Geographic Info
  country     String?  // "United States", "India", "Germany", etc.
  city        String?  // "New York", "Mumbai", "Berlin", etc.
  ipAddress   String?  // Store IP for debugging
  
  // Referral Info
  referrer    String?  // "instagram.com", "twitter.com", "direct", etc.
  utmSource   String?  // UTM parameters if present
  utmMedium   String?
  utmCampaign String?
  
  // Relationship
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  
  // Indexes for fast queries
  @@index([linkId, clickedAt])
  @@index([linkId, country])
  @@index([linkId, deviceType])
}
